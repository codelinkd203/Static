{
  "name": "static",
  "version": "3.1.3",
  "description": "Instant Local Web Preview — drop a folder, serve it, preview it.",
  "main": "main.js",
  "author": "Static",
  "license": "MIT",
  "private": true,
  "bin": {
    "static": "bin/static"
  },
  "scripts": {
    "start": "electron .",
    "build": "node build.js"
  },
  "devDependencies": {
    "electron": "30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.static.app",
    "productName": "Static",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "bin/**/*",
      "assets/**/*",
      "logos.icns",
      "!output/**/*",
      "!dist/**/*",
      "!build.js"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg",
      "icon": "logos.icns"
    },
    "dmg": {
      "icon": "logos.icns"
    }
  }
}
